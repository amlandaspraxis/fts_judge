datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  JUDGE
  AUDIENCE
  HELP_DESK
}

enum EventStatus {
  SETUP
  JUDGING_OPEN
  VOTING_OPEN
  JUDGING_CLOSED
  VOTING_CLOSED
  RESULTS_LOCKED
  RESULTS_PUBLISHED
}

model User {
  id            String            @id @default(uuid())
  name          String
  email         String            @unique
  passwordHash  String            @map("password_hash")
  role          Role              @default(AUDIENCE)
  status        String            @default("ACTIVE")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  
  judgeAssignments JudgeAssignment[]
  judgeScores      JudgeScore[]
  audienceVotes    AudienceVote[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Event {
  id              String            @id @default(uuid())
  name            String
  status          EventStatus       @default(SETUP)
  judgingOpenAt   DateTime?         @map("judging_open_at")
  judgingCloseAt  DateTime?         @map("judging_close_at")
  votingOpenAt    DateTime?         @map("voting_open_at")
  votingCloseAt   DateTime?         @map("voting_close_at")
  resultsLocked   Boolean           @default(false) @map("results_locked")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  categories      Category[]
  participants    Participant[]
  judgeAssignments JudgeAssignment[]
  audienceVotes   AudienceVote[]
  results         Result[]

  @@map("events")
}

model Category {
  id          String            @id @default(uuid())
  eventId     String            @map("event_id")
  name        String
  code        String            @default("")
  description String?
  status      String            @default("ACTIVE")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants     Participant[]
  judgeAssignments JudgeAssignment[]
  judgeScores      JudgeScore[]
  audienceVotes    AudienceVote[]
  results          Result[]

  @@map("categories")
}

model Participant {
  id                 String         @id @default(uuid())
  eventId            String         @map("event_id")
  categoryId         String         @map("category_id")
  participantCode    String         @map("participant_code")
  registrationNumber String         @map("registration_number")
  name               String
  phoneNumber        String         @map("phone_number")
  routineTitle       String         @map("routine_title")
  status             String         @default("ACTIVE")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  judgeScores  JudgeScore[]
  audienceVotes AudienceVote[]
  results      Result[]

  @@unique([eventId, participantCode])
  @@map("participants")
}

model JudgeAssignment {
  id         String   @id @default(uuid())
  judgeId    String   @map("judge_id")
  categoryId String   @map("category_id")
  eventId    String   @map("event_id")
  createdAt  DateTime @default(now()) @map("created_at")

  judge    User     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([judgeId, categoryId, eventId])
  @@map("judge_assignments")
}

model JudgeScore {
  id            String         @id @default(uuid())
  judgeId       String         @map("judge_id")
  participantId String         @map("participant_id")
  categoryId    String         @map("category_id")
  score         Float
  revisionCount Int            @default(0) @map("revision_count")
  locked        Boolean        @default(false)
  submittedAt   DateTime       @default(now()) @map("submitted_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  judge        User           @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  participant  Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  scoreHistory ScoreHistory[]

  @@unique([judgeId, participantId])
  @@map("judge_scores")
}

model ScoreHistory {
  id         String     @id @default(uuid())
  scoreId    String     @map("score_id")
  oldScore   Float      @map("old_score")
  newScore   Float      @map("new_score")
  changedBy  String     @map("changed_by")
  reason     String?
  changedAt  DateTime   @default(now()) @map("changed_at")

  judgeScore JudgeScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@map("score_history")
}

model AudienceVote {
  id            String      @id @default(uuid())
  audienceId    String      @map("audience_id")
  participantId String      @map("participant_id")
  categoryId    String      @map("category_id")
  eventId       String      @map("event_id")
  submittedAt   DateTime    @default(now()) @map("submitted_at")

  audience    User        @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([audienceId, categoryId, eventId])
  @@map("audience_votes")
}

model Result {
  id             String      @id @default(uuid())
  eventId        String      @map("event_id")
  categoryId     String      @map("category_id")
  participantId  String      @map("participant_id")
  judgeScore     Float       @map("judge_score")
  audienceScore  Float       @map("audience_score")
  judgeWeight    Float       @default(0.85) @map("judge_weight")
  audienceWeight Float       @default(0.15) @map("audience_weight")
  finalScore     Float       @map("final_score")
  rank           Int?
  calculatedAt   DateTime    @default(now()) @map("calculated_at")

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([eventId, categoryId, participantId])
  @@map("results")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
