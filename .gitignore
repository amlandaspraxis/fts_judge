# ==============================================================================
# Git Ignore Configuration - Freshmen Talent Search 2026
# Strict security: prevents accidental credential or sensitive data leakage
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment files & secrets (NEVER commit to GitHub)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.backup
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
database/.env
database/.env.*

# Explicit exceptions: only allow safe example / template files
!.env.example
!.env.template
!backend/.env.example
!frontend/.env.example
!database/.env.example

# ------------------------------------------------------------------------------
# 2. Private keys, certificates, & credentials
# ------------------------------------------------------------------------------
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
id_rsa
secrets/

# ------------------------------------------------------------------------------
# 3. Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
package-lock.json

# ------------------------------------------------------------------------------
# 4. Build output & production artifacts
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. Logs & debugging outputs
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 6. Databases, local SQLite, & database backups
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.bak

# ------------------------------------------------------------------------------
# 7. OS, editor, and IDE system files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
